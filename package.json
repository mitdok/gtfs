{
  "name": "gtfs-studio",
  "version": "0.0.0",
  "private": true,
  "description": "GTFS-JP/RT 公開データ生成・配信WEBサービス（西沢ツールWEB版）",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "gtfs:validate": "node scripts/gtfs-validate.mjs",
    "gtfs:golden": "pnpm --filter @gtfs-studio/core build && node scripts/gtfs-golden-fixtures.mjs",
    "gtfs:validate-golden": "pnpm gtfs:golden && node scripts/gtfs-validate-golden.mjs"
  },
  "packageManager": "pnpm@10.33.0"
}
